{
  "name": "mono-repo",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "prepare": "husky",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,css,md,json}\"",
    "update-version": "changeset",
    "check-version": "changeset version",
    "studio": "pnpm -r studio",
    "test": "pnpm -r test",
    "lint-staged": "lint-staged"
  },
  "keywords": [],
  "author": "Santiago Mustafá",
  "repository": {
    "url": "https://github.com/santiagoemanuel/monorepo"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.10.10",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix --cache"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
