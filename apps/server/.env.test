PORT=3000
NODE_ENV=test

# Base local efímera para la suite de tests.
SQLITE_DATABASE=file:./.data/test.sqlite

# Credenciales aisladas para autenticación en tests.
JWT_SECRET=test-only-secret
HASH_SALT=4

# CORS necesario para crear la aplicación Express en Vitest.
HOST='["http://localhost:5173"]'
LOCALHOST_IP='["http://localhost:5173"]'

# No se envían correos durante los tests.
MAILERSEND_TOKEN=test-only-mail-token
PUBLIC_WEB_URL=http://localhost:5173
